[Unit]
Description=Receive Taildrop files into the StonkyTonkyWonky analyst inbox
After=network-online.target

[Service]
ExecStart=/usr/bin/tailscale file get --loop --conflict=rename %h/TheLab/Documents/Trading/ForwardEstimates/analysts/inbox
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
